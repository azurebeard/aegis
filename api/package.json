{
  "name": "@aegis/api",
  "version": "0.1.0",
  "private": true,
  "description": "XDR Hub (aegis) API — Azure Functions v4, TypeScript, Node 22",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "package": "npm run clean && npm ci && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/ai-projects": "^2.4.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.6.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.31.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "applicationinsights": "^3.15.1",
    "jose": "^5.10.0",
    "json-canonicalize": "^1.2.0"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@opentelemetry/sdk-node": "0.217.0",
    "@opentelemetry/exporter-prometheus": "0.217.0",
    "@opentelemetry/core": "^2.8.0",
    "protobufjs": "^8.0.2",
    "uuid": "^11.0.0",
    "vite": "^8.1.0"
  }
}
